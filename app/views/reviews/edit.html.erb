<% content_for :title, "Отзыв о компании «#{@company.name}»" %>

<%= render layout: "components/superorganisms/content_page", locals: { title: "Отзыв о компании «#{@company.name}»", medium: true } do %>
  <% unless current_user.is_admin? %>
    <p class="A_Text">После сохранения отзыв снова уйдёт на проверку модератору.</p>
  <% end %>

  <%= render "form", company: @company, review: @review %>
  <%= link_to "← К компании", @company, class: "A_TextLink A_Text" %>
<% end %>
