<% content_for :title, "Все истории" %>

<%= render layout: "components/superorganisms/content_page", locals: { title: "Все истории", medium: true } do %>
  <div class="C_StoryList" id="stories">
    <% @stories.each do |story| %>
      <%= render story %>
      <%= link_to "Открыть историю", story, class: "A_TextLink A_Text" %>
    <% end %>
  </div>

  <div class="M_FormActions">
    <%= link_to "Рассказать историю", new_story_path, class: "A_PillButton A_PillButtonLight" %>
  </div>
<% end %>
