<%= form_with(model: story) do |form| %>
  <% if story.errors.any? %>
    <div style="color: red">
      <h2>Не удалось сохранить историю:</h2>

      <ul>
        <% story.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Заголовок", style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :body, "Ваша история", style: "display: block" %>
    <%= form.textarea :body, rows: 10 %>
  </div>

  <div>
    <%= form.label :images, "Картинки (необязательно, до #{Story::MAX_IMAGES} штук, PNG, JPG или WEBP до 5 МБ)", style: "display: block" %>
    <p>Проверьте, что на картинке нет имён, лиц и названий компаний</p>

    <% story.images.select(&:persisted?).each do |image| %>
      <div>
        <%= form.hidden_field :images, multiple: true, value: image.signed_id %>
        <%= image_tag image.variant(resize_to_limit: [ 150, 150 ], saver: { strip: true }) %>
        <label>
          <%= check_box_tag "story[remove_image_ids][]", image.id, image.id.to_s.in?(story.remove_image_ids), id: nil %>
          удалить
        </label>
      </div>
    <% end %>

    <%= form.file_field :images, multiple: true, accept: Story::IMAGE_TYPES.join(",") %>
  </div>

  <div>
    <%= form.label :grade, "Ваш грейд", style: "display: block" %>
    <%= form.select :grade, Story::GRADE_LABELS.invert, include_blank: "Не указывать" %>
  </div>

  <div>
    <p>Профессия</p>
    <%= form.collection_check_boxes :tag_ids, Tag.profession, :id, :name %>
  </div>

  <div>
    <p>Тема</p>
    <%= form.collection_check_boxes :tag_ids, Tag.topic, :id, :name %>
  </div>

  <div>
    <p>Этап</p>
    <%= form.collection_check_boxes :tag_ids, Tag.stage, :id, :name %>
  </div>

  <div>
    <%= form.label :company_id, "Компания", style: "display: block" %>
    <%= form.collection_select :company_id, Company.published.order(:name), :id, :name, include_blank: "Без компании" %>
  </div>

  <div>
    <%= form.checkbox :anonymous %>
    <%= form.label :anonymous, "Опубликовать анонимно" %>
  </div>

  <% if current_user.is_admin? %>
    <div>
      <%= form.label :status, "Статус", style: "display: block" %>
      <%= form.select :status, Story::STATUS_LABELS.invert %>
    </div>

    <div>
      <%= form.label :article_id, "Статья", style: "display: block" %>
      <%= form.collection_select :article_id, Article.all, :id, :title, include_blank: "Без статьи" %>
    </div>
  <% end %>

  <div>
    <%= form.submit "Сохранить" %>
  </div>
<% end %>