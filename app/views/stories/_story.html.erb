<div id="<%= dom_id story %>">
  <h2><%= story.title %></h2>

  <p>
    <%= story.grade %> ·
    <%= story.anonymous? ? "Анонимно" : story.user.email.split("@").first %> ·
    <%= story.created_at.strftime("%d.%m.%Y") %>
  </p>

  <p><%= story.body %></p>

  <p>
    <% story.tags.each do |tag| %>
      #<%= tag.name %>
    <% end %>
  </p>

  <% if story.article %>
    <p>Что говорит закон: <%= link_to story.article.title, story.article %></p>
  <% end %>

  <% if can? :update, story %>
    <p>Статус: <%= story.status %></p>
  <% end %>
</div>