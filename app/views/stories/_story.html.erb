<div id="<%= dom_id story %>">
  <div>
    <strong>User:</strong>
    <%= story.user_id %>
  </div>

  <div>
    <strong>Article:</strong>
    <%= story.article_id %>
  </div>

  <div>
    <strong>Title:</strong>
    <%= story.title %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= story.body %>
  </div>

  <div>
    <strong>Grade:</strong>
    <%= story.grade %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= story.status %>
  </div>

  <div>
    <strong>Anonymous:</strong>
    <%= story.anonymous %>
  </div>

</div>
