<div id="<%= dom_id story %>">
  <%= content_tag local_assigns.fetch(:heading, :h2), story.title %>

  <p>
    <% if story.anonymous? %>
      Анонимно
    <% else %>
      <%= avatar_for(story.user, size: 24) %> <%= story.user.display_name %>
    <% end %>
    <% if story.grade %> · <%= Story::GRADE_LABELS[story.grade] %><% end %>
    · <%= story.created_at.strftime("%d.%m.%Y") %>
  </p>

  <p><%= story.body %></p>

  <p>
    <% story.tags.each do |tag| %>
      #<%= tag.name %>
    <% end %>
  </p>

  <% if story.company %>
    <p>Компания: <%= link_to story.company.name, story.company %></p>
  <% end %>

  <% if story.article %>
    <p>Что говорит закон: <%= link_to story.article.title, story.article %></p>
  <% end %>

  <% if can? :update, story %>
    <p>Статус: <%= Story::STATUS_LABELS[story.status] %></p>
  <% end %>
</div>