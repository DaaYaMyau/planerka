<% blue = local_assigns[:blue] %>
<footer class="<%= class_names("O_Footer", "O_FooterBlue" => blue) %>">
  <div class="M_FooterContent">
    <%= render "components/molecules/brand", modifier: "M_BrandLarge", caption: "пространство реальных рабочих историй, открытых обсуждений и полезных советов" %>
    <%= render "subscriptions/form", subscription: Subscription.new %>
  </div>
  <div class="C_FooterLinks">
    <% if user_signed_in? || !Rails.configuration.x.teaser %>
      <%= render "components/molecules/footer_navigation" %>
    <% end %>
    <%= render "components/molecules/footer_contacts", folder: (blue ? "splash" : "footer") %>
    <%= render "components/molecules/footer_credits" %>
  </div>
</footer>
