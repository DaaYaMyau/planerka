<section class="O_SafetyAndPrivacy" id="safety">
  <%= render "components/molecules/section_header", title: "Безопасность и анонимность", image: "about/tab_safety.svg" %>
  <div class="W_Section W_SectionViolet">
    <div class="C_FoldersGrid">
      <% [
        { title: "Анонимность", text: "Вы можете публиковать истории\nи задавать вопросы без указания своего имени" },
        { title: "Личные данные", text: "Не публикуйте имена, фотографии, контакты и сведения, по которым можно узнать человека" },
        { title: "Конфиденциальность", text: "Не допускайте раскрытия коммерческой тайны и внутренних документов компаний" },
        { title: "Защита автора", text: "Представители компаний не видят личность автора и не могут самостоятельно удалить его отзыв" },
        { title: "Без давления", text: "Угрозы, преследование и попытки установить личность автора строго запрещены" },
        { title: "Право на обращение", text: "Узнали себя в публикации или заметили раскрытие личных данных? Сообщите нам" }
      ].each do |folder| %>
        <%= render "components/molecules/category_folder", size: "wide", color: "green", **folder %>
      <% end %>
    </div>
  </div>
</section>
