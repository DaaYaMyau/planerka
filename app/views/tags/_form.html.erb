<%= form_with(model: tag) do |form| %>
  <% if tag.errors.any? %>
    <div style="color: red">
      <h2>Не удалось сохранить тег:</h2>

      <ul>
        <% tag.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Название", style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :kind, "Тип", style: "display: block" %>
    <%= form.select :kind, Tag::KIND_LABELS.invert %>
  </div>

  <div>
    <%= form.label :color, "Цвет", style: "display: block" %>
    <%= form.select :color, Tag::COLOR_LABELS.invert, include_blank: "Без цвета" %>
  </div>

  <div>
    <%= form.submit "Сохранить" %>
  </div>
<% end %>
