<% content_for :title, "Тег «#{@tag.name}»" %>

<h1>Тег «<%= @tag.name %>»</h1>
<p>Тип: <%= Tag::KIND_LABELS[@tag.kind] %></p>

<p>
  <%= link_to "Редактировать", edit_tag_path(@tag) %> ·
  <%= link_to "← Все теги", tags_path %>
</p>

<%= button_to "Удалить тег", @tag, method: :delete, form: { data: { turbo_confirm: "Удалить тег?" } } %>
