<%= form_with model: company do |form| %>
  <% if company.errors.any? %>
    <div style="color: red">
      <% company.errors.each do |error| %>
        <p><%= error.message %></p>
      <% end %>
    </div>
  <% end %>

  <% if company.new_record? %>
    <div data-controller="similar-companies" data-similar-companies-url-value="<%= similar_companies_path %>">
      <%= form.label :name, "Название", style: "display: block" %>
      <%= form.text_field :name, autocomplete: "off",
                          data: { similar_companies_target: "input", action: "input->similar-companies#search" } %>
      <%= turbo_frame_tag "similar_companies", data: { similar_companies_target: "frame" } %>
    </div>
  <% elsif current_user.is_admin? %>
    <div>
      <%= form.label :name, "Название", style: "display: block" %>
      <%= form.text_field :name %>
    </div>
  <% end %>

  <div>
    <%= form.label :industry, "Сфера", style: "display: block" %>
    <%= form.text_field :industry, list: "industries" %>
    <datalist id="industries">
      <% Company.industries.each do |industry| %>
        <option value="<%= industry %>"></option>
      <% end %>
    </datalist>
  </div>

  <div>
    <%= form.label :website, "Сайт (необязательно)", style: "display: block" %>
    <%= form.text_field :website, placeholder: "example.ru" %>
  </div>

  <% if company.persisted? %>
    <div>
      <%= form.label :description, "Описание", style: "display: block" %>
      <%= form.textarea :description, rows: 4 %>
    </div>

    <div>
      <%= form.label :inn, "ИНН", style: "display: block" %>
      <%= form.text_field :inn %>
    </div>
  <% end %>

  <% if current_user.is_admin? %>
    <div>
      <%= form.label :slug, "Адрес страницы (slug)", style: "display: block" %>
      <%= form.text_field :slug %>
      <p>Если оставить пустым, адрес придумается из названия.</p>
    </div>

    <div>
      <%= form.label :status, "Статус", style: "display: block" %>
      <%= form.select :status, Company::STATUS_LABELS.invert %>
    </div>
  <% end %>

  <div>
    <%= form.submit "Сохранить" %>
  </div>
<% end %>
