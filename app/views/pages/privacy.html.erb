<% content_for :title, "Политика конфиденциальности" %>

<%= render layout: "components/superorganisms/content_page", locals: { title: "Политика конфиденциальности" } do %>
  <p class="A_Hint">Черновик: окончательный текст будет согласован перед запуском.</p>

  <div class="C_CardGrid">
    <section class="W_Card">
      <h2 class="A_Heading">Какие данные мы собираем</h2>
      <p class="A_Text">Почту, которую вы оставили в форме подписки, и дату, когда вы дали согласие на её обработку.</p>
    </section>

    <section class="W_Card">
      <h2 class="A_Heading">Зачем</h2>
      <p class="A_Text">Чтобы сообщить вам о запуске Планёрки. Мы не передаём почту третьим лицам и не присылаем рекламу.</p>
    </section>

    <section class="W_Card">
      <h2 class="A_Heading">Как отписаться</h2>
      <p class="A_Text">Напишите нам: [почта проекта] — и мы удалим вашу почту из списка.</p>
    </section>
  </div>
<% end %>
