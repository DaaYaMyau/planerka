<% content_for :title, "Редактирование статьи" %>

<%= render layout: "components/superorganisms/content_page", locals: { title: "Редактирование статьи", medium: true } do %>
  <%= render "form", article: @article %>
  <div class="M_FormActions">
    <%= link_to "← К статье", @article, class: "A_TextLink A_Text" %>
