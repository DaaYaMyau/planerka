<% content_for :title, "Разобраться" %>

<h1>Разобраться</h1>
<p>Что говорит закон и в каких ситуациях оказываются другие молодые специалисты.</p>

<section>
  <h2>Популярные ситуации</h2>
  <p>
    <% @popular_topics.each do |tag| %>
      <%= link_to "#{tag.name} (#{@topic_counts[tag.id]})", root_path(topic: tag.id) %>
    <% end %>
  </p>
</section>

<section>
  <h2>Статьи</h2>

  <%= form_with url: articles_path, method: :get do |form| %>
    <%= form.search_field :q, value: params[:q], placeholder: "Поиск по статьям" %>
    <%= form.submit "Найти", name: nil %>
    <% if params[:q].present? %>
      <%= link_to "Сбросить", articles_path %>
    <% end %>
  <% end %>

  <% if @articles.empty? %>
    <p>Статей по запросу «<%= params[:q] %>» не нашлось.</p>
    <p><%= link_to "Сбросить поиск", articles_path %></p>
  <% end %>

  <% @articles.each do |article| %>
    <article>
      <h3><%= link_to article.title, article %></h3>
      <p><%= article.summary %></p>
    </article>
  <% end %>
</section>

<% if can? :create, Article %>
  <p><%= link_to "Новая статья", new_article_path %></p>
<% end %>
