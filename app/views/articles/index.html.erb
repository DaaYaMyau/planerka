<% content_for :title, "Разобраться" %>

<%= render layout: "components/superorganisms/content_page", locals: { title: "Разобраться" } do %>
  <p class="A_Text">Что говорит закон о ситуациях, с которыми сталкиваются молодые специалисты.</p>

  <%= form_with url: articles_path, method: :get, id: "articles_search", class: "M_FormActions" do %>
    <%= render "components/molecules/search_field", form: "articles_search", placeholder: "Поиск по статьям" %>
    <% if params[:q].present? %>
      <%= link_to "Сбросить", articles_path, class: "A_TextLink A_TextSmall" %>
    <% end %>
  <% end %>

  <% if @articles.empty? %>
    <div class="M_FeedEmpty">
      <p class="A_Text">Статей по запросу «<%= params[:q] %>» не нашлось.</p>
      <%= link_to "Сбросить поиск", articles_path, class: "A_TextLink A_Text" %>
    </div>
  <% else %>
    <div class="C_CardGrid">
      <% @articles.each do |article| %>
        <article class="W_Card">
          <h2 class="A_StoryTitle"><%= link_to article.title, article, class: "A_Link" %></h2>
          <p class="A_Text"><%= article.summary %></p>
        </article>
      <% end %>
    </div>
  <% end %>

  <% if can? :create, Article %>
    <div class="M_FormActions">
      <%= link_to "Новая статья", new_article_path, class: "A_PillButton A_PillButtonLight" %>
    </div>
  <% end %>
<% end %>
