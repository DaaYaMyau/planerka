<% content_for :title, "Юридические вопросы" %>

<h1>Юридические вопросы</h1>

<% @articles.each do |article| %>
  <article>
    <h2><%= link_to article.title, article %></h2>
    <p><%= article.summary %></p>
  </article>
<% end %>

<% if can? :create, Article %>
  <%= link_to "Новая статья", new_article_path %>
<% end %>