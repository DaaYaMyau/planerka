<%= form_with(model: article) do |form| %>
  <% if article.errors.any? %>
    <div style="color: red">
      <h2>Не удалось сохранить статью:</h2>

      <ul>
        <% article.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Заголовок", style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :slug, "Адрес страницы (slug)", style: "display: block" %>
    <%= form.text_field :slug %>
  </div>

  <div>
    <%= form.label :summary, "Кратко", style: "display: block" %>
    <%= form.textarea :summary %>
  </div>

  <div>
    <%= form.label :body, "Текст", style: "display: block" %>
    <%= form.textarea :body %>
  </div>

  <div>
    <%= form.submit "Сохранить" %>
  </div>
<% end %>
