<% content_for :title, "Почта и пароль" %>

<%= render layout: "components/superorganisms/content_page", locals: { title: "Почта и пароль", narrow: true } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "O_Form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="M_FormField">
      <%= f.label :email, class: "A_Label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "A_Input" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="A_Hint"><%= t("devise.registrations.edit.currently_waiting_confirmation_for_email", email: resource.unconfirmed_email) %></p>
    <% end %>

    <div class="M_FormField">
      <%= f.label :password, class: "A_Label" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "A_Input" %>
      <p class="A_Hint">
        <%= t("devise.registrations.edit.leave_blank_if_you_don_t_want_to_change_it") %>
        <% if @minimum_password_length %>
          · <%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %>
        <% end %>
      </p>
    </div>

    <div class="M_FormField">
      <%= f.label :password_confirmation, class: "A_Label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "A_Input" %>
    </div>

    <div class="M_FormField">
      <%= f.label :current_password, class: "A_Label" %>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "A_Input" %>
      <p class="A_Hint"><%= t("devise.registrations.edit.we_need_your_current_password_to_confirm_your_changes") %></p>
    </div>

    <div class="M_FormActions">
      <%= f.submit t("devise.registrations.edit.update"), class: "A_PillButton" %>
      <%= link_to t("devise.shared.links.back"), :back, class: "A_TextLink" %>
    </div>
  <% end %>

  <section class="W_Card">
    <h2 class="A_Heading"><%= t("devise.registrations.edit.cancel_my_account") %></h2>
    <p class="A_Text"><%= t("devise.registrations.edit.unhappy") %></p>
    <div class="M_FormActions">
      <%= button_to t("devise.registrations.edit.cancel_my_account"), registration_path(resource_name), method: :delete, class: "A_PillButton",
                    data: { confirm: t("devise.registrations.edit.are_you_sure"), turbo_confirm: t("devise.registrations.edit.are_you_sure") } %>
    </div>
  </section>
<% end %>
