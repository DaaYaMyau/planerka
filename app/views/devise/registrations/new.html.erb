<% content_for :title, t("devise.registrations.new.sign_up") %>

<%= render layout: "components/superorganisms/content_page", locals: { title: t("devise.registrations.new.sign_up"), narrow: true } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "O_Form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="M_FormField">
      <%= f.label :email, class: "A_Label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "A_Input" %>
    </div>

    <div class="M_FormField">
      <%= f.label :password, class: "A_Label" %>
      <%= f.password_field :password, autocomplete: "new-password", class: "A_Input" %>
      <% if @minimum_password_length %>
        <p class="A_Hint"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></p>
      <% end %>
    </div>

    <div class="M_FormField">
      <%= f.label :password_confirmation, class: "A_Label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "A_Input" %>
    </div>

    <div class="M_FormActions">
      <%= f.submit t("devise.registrations.new.sign_up"), class: "A_PillButton" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
