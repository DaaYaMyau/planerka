<% content_for :title, t("devise.passwords.new.forgot_your_password") %>

<%= render layout: "components/superorganisms/content_page", locals: { title: t("devise.passwords.new.forgot_your_password"), narrow: true } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "O_Form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="M_FormField">
      <%= f.label :email, class: "A_Label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "A_Input" %>
    </div>

    <div class="M_FormActions">
      <%= f.submit t("devise.passwords.new.send_me_reset_password_instructions"), class: "A_PillButton" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
