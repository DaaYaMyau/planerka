<% content_for :title, t("devise.passwords.edit.change_your_password") %>

<%= render layout: "components/superorganisms/content_page", locals: { title: t("devise.passwords.edit.change_your_password"), narrow: true } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "O_Form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="M_FormField">
      <%= f.label :password, t("devise.passwords.edit.new_password"), class: "A_Label" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "A_Input" %>
      <% if @minimum_password_length %>
        <p class="A_Hint"><%= t("devise.shared.minimum_password_length", count: @minimum_password_length) %></p>
      <% end %>
    </div>

    <div class="M_FormField">
      <%= f.label :password_confirmation, t("devise.passwords.edit.confirm_new_password"), class: "A_Label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "A_Input" %>
    </div>

    <div class="M_FormActions">
      <%= f.submit t("devise.passwords.edit.change_my_password"), class: "A_PillButton" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
